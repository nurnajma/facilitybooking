<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true"
    tools:context=".AddFacilityActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add New Facility"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="24dp" />

        <!-- Form Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Facility Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Facility Name *"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/edtFacilityName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="e.g., Conference Room A"
                    android:padding="12dp"
                    android:background="@android:drawable/edit_text"
                    android:inputType="text"
                    android:textColor="@color/black"
                    android:layout_marginBottom="16dp" />

                <!-- Description -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/edtDescription"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:hint="Enter facility description"
                    android:gravity="top|start"
                    android:padding="12dp"
                    android:background="@android:drawable/edit_text"
                    android:inputType="textMultiLine"
                    android:maxLines="4"
                    android:layout_marginBottom="16dp"
                    android:textColor="@color/black"/>

                <!-- Capacity -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Capacity *"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp"
                    />

                <EditText
                    android:id="@+id/edtCapacity"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="e.g., 50"
                    android:padding="12dp"
                    android:background="@android:drawable/edit_text"
                    android:inputType="number"
                    android:layout_marginBottom="16dp"
                    android:textColor="@color/black"/>

                <!-- Hourly Rate -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hourly Rate (RM) *"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/edtHourlyRate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="e.g., 100.00"
                    android:padding="12dp"
                    android:background="@android:drawable/edit_text"
                    android:inputType="numberDecimal"
                    android:layout_marginBottom="16dp"
                    android:textColor="@color/black"/>

                <!-- Location -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Location *"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/edtLocation"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="e.g., Building A, Level 2"
                    android:padding="12dp"
                    android:background="@android:drawable/edit_text"
                    android:inputType="text"
                    android:layout_marginBottom="16dp"
                    android:textColor="@color/black"/>

                <!-- Image URL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Image URL (optional)"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp" />

                <ImageView
                    android:id="@+id/ivImagePreview"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:contentDescription="Image preview"
                    android:layout_marginBottom="8dp"
                    android:visibility="visible" />

                <Button
                    android:id="@+id/btnChooseImage"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Choose Image"
                    android:layout_marginBottom="16dp" />

                <!-- Status -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status *"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerStatus"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/edit_text"
                    android:padding="12dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textSize="16sp"
                android:backgroundTint="#9E9E9E"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Save Facility"
                android:textSize="16sp"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>