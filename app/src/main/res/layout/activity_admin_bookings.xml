<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".AdminBookingsActivity">

    <LinearLayout
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/design_default_color_primary"
        android:padding="16dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All Bookings (Admin)"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage all facility bookings"
            android:textSize="14sp"
            android:textColor="#E0E0E0" />

    </LinearLayout>

    <!-- Filter Buttons -->
    <HorizontalScrollView
        android:id="@+id/filterBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/titleBar"
        android:padding="8dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="All"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"
                android:minWidth="80dp" />

            <Button
                android:id="@+id/btnFilterPending"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Pending"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#FF9800"
                android:minWidth="80dp" />

            <Button
                android:id="@+id/btnFilterApproved"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Approved"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#4CAF50"
                android:minWidth="80dp" />

            <Button
                android:id="@+id/btnFilterRejected"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Rejected"
                android:textSize="12sp"
                android:backgroundTint="#F44336"
                android:minWidth="80dp" />

        </LinearLayout>

    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAdminBookings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/filterBar"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="No bookings found"
        android:textSize="16sp"
        android:textColor="#999999"
        android:visibility="gone" />

</RelativeLayout>